{
  "name": "e-commerce-platform",
  "version": "1.0.0",
  "description": "Full-stack E-commerce Application with React/Vite Frontend and Express Backend",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:all": "node scripts/dev-all.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:user": "npm --prefix frontend run dev:user",
    "dev:admin": "npm --prefix frontend run dev:admin",
    "test": "npm --prefix backend test",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview"
  }
}
