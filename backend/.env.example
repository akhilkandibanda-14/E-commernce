PORT=5000
USER_PORT=5000
ADMIN_PORT=5001
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
NODE_ENV=development

# JWT Secret Configuration:
# REQUIRED in all environments. Must be a cryptographically random string of at least 32 characters.
# Generate in Node via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit your production JWT_SECRET to version control.
JWT_SECRET=replace_with_a_random_64_char_hex_string

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/giftingwellness?retryWrites=true&w=majority

# Transactional Email & Lead Alerts (Resend / AWS SES / SendGrid / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@giftingwellness.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="Giftingwellness Orders <orders@giftingwellness.com>"
ADMIN_ALERT_EMAIL="sales@giftingwellness.com"
SUPPORT_PHONE="+91 91212 99914"
 
# Clerk Authentication (Get from https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
